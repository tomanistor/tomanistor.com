{
	"name": "tomanistor.com",
	"version": "2.0.0",
	"description": "Personal portfolio website of Toma Nistor",
	"type": "module",
	"author": "Toma Nistor",
	"license": "ISC",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tomanistor/tomanistor.com.git"
	},
	"bugs": {
		"url": "https://github.com/tomanistor/tomanistor.com/issues"
	},
	"homepage": "https://github.com/tomanistor/tomanistor.com#readme",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.5",
		"@fontsource/inter-tight": "5.3.0",
		"@playwright/test": "^1.64.1",
		"@sentry/sveltekit": "^11.11.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26",
		"@vitest/browser-playwright": "^4.1.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"globals": "^16.5.0",
		"pixi.js": "^8.22.0",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^3.5.2",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^4.1.12",
		"vitest-browser-svelte": "^3.1.0"
	},
	"packageManager": "pnpm@12.5.1"
}
